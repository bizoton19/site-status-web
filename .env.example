# Copy this file to `.env` in the project root. Vite only exposes variables prefixed with VITE_.

# --- Clerk (customer auth + organizations)
# Dashboard: https://dashboard.clerk.com/apps/app_3GC6eR1qb7yHeHcIY0sm0eDTvha
# API keys → Publishable key
VITE_CLERK_PUBLISHABLE_KEY=

# --- Legacy Azure AD / MSAL (deprecated — replaced by Clerk)
# VITE_AAD_CLIENT_ID=
# VITE_AAD_TENANT_ID=
# VITE_REDIRECT_URI=http://localhost:8080/
# VITE_POST_LOGOUT_REDIRECT_URI=http://localhost:8080/

# --- Local dev CORS
# `npm run dev` loads `.env.development`, which sets VITE_DEV_PROXY=true so requests go to
# same-origin /__healthchker/api/... and Vite forwards to Azure (no browser CORS).
# The proxy is ignored in production builds (import.meta.env.DEV). Do not set VITE_API_BASE_URL
# to your SWA URL — polls would return index.html instead of Azure output.

# Azure Functions base URL (no trailing slash before /api). Used for `vite build` / production.
VITE_API_BASE_URL=https://api.outpost13.app/api

# Function or host key (?code=…) — required on every call until JWT middleware ships.
VITE_API_CODE=

# --- HTTP function route names
VITE_POLLER_FUNCTION=httppollertrigger
VITE_POLL_URL_FUNCTION=pollurl
VITE_URL_LIST_FUNCTION=statusurllistreader
VITE_STATUS_FUNCTION=statussitestatereader
VITE_URL_PERSISTER_FUNCTION=urlpersister
VITE_HISTORY_FUNCTION=statushistoryreader
VITE_PUBLIC_STATUSES_FUNCTION=publicstatusesreader

# Public contact form (POST {VITE_API_BASE_URL}/{VITE_CONTACT_FUNCTION}).
# Site key is public and is baked into the SPA. Create the widget in Cloudflare Turnstile
# for outpost13.app. See azure-functions/contact/README.md.
VITE_TURNSTILE_SITE_KEY=
VITE_CONTACT_FUNCTION=contact

# --- Contact function (Function App settings only — NOT Vite, NOT the SWA)
# Vite ignores names without the VITE_ prefix, but do not put the secret in this file
# when it is copied to a deployed frontend environment.
# TURNSTILE_SECRET_KEY=
# TURNSTILE_HOSTNAMES=outpost13.app
# CONTACT_TABLE_NAME=ContactInquiries
# CONTACT_TABLE_CONNECTION=
